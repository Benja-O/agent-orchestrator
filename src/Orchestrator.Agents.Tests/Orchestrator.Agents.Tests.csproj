<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orchestrator.Agents\Orchestrator.Agents.csproj" />
  </ItemGroup>

  <!--
    The real templates, not copies. The workspace preparer's job is to put these exact files in
    the generated workspace, so a template that gets renamed or deleted has to break this suite
    rather than surface as an agent that quietly has no definition.
  -->
  <ItemGroup>
    <Content Include="..\..\templates\**\*" LinkBase="Templates" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
