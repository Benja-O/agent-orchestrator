<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Orchestrator.GeneratedAppVerification</RootNamespace>
  </PropertyGroup>

  <!--
    No project reference to anything. This harness talks to the generated application over HTTP
