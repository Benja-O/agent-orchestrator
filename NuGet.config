<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft.CodeAnalysis.LanguageServer is not published to nuget.org. It lives in the
  public Visual Studio feed (azure-public/vside/vs-impl), which is where the C# Dev Kit
  extension gets it from too. See ADR-006 and ADR-013 in DECISIONS.md.

  The source mapping is deliberate: the Visual Studio feed is trusted for exactly one
  package family and nothing else, so nothing can be resolved from it by accident.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="visual-studio-impl" value="https://pkgs.dev.azure.com/azure-public/vside/_packaging/vs-impl/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="visual-studio-impl">
      <package pattern="Microsoft.CodeAnalysis.LanguageServer.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
